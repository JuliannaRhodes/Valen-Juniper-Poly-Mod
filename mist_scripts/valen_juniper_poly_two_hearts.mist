scene(eastern_road);
camera_position(vjp2h_camera1);
place_actor(ari, east, vjp2h_ari_entrance);
place_actor(juniper, south, vjp2h_juniper_bridge);
place_actor(valen, north, vjp2h_valen_bridge);
setup_prop(foraging_basket1);
request_music_play(juniper);
setup_prop(water_mint1);

sim {
    {
        wait(0.25);
        fade_in(2);
    }
    {
        wait(4);
        free bark_speech(valen, annoyed);
    }
    {
        wait(1.75);
        next_line(); //0
    }
}

next_line(); // 1
next_line(); // 2
next_line(); // 3
next_line(); // 4

sim {
    {
        free bark_speech(valen, ellipses);
        next_line(); // 5
    }
}

next_line(); // 6
        
sim {
    {
        wait(2);
        free bark_speech(juniper, sleepy);
    }
    {
        next_line(); // 7
    }
    {
        wait(2);
        animate(juniper, yawn);
        wait(3.5);
        animate(juniper, idle);
    }
}


next_line(); // 8

sim {
    {
        walk(ari, vjp2h_ari_start);
        face(ari, east);
    }
    {
        next_line(); // 9
        wait(0.75);
    }
}

sim {
    {
        free bark_speech(juniper, exclamation_mark);
        wait(0.5);
        face(juniper, west);
        wait(0.5);
        free bark_speech(valen, question_mark);
    }
    {
        next_line(); // 10
        wait(1);
        free bark_speech(valen, angry);
        close_textbox();
    }
}


walk_slow(ari, vjp2h_ari_bridge);
face(valen, west);

next_line(); // 11
next_line(); // 12
wait(0.75);
free bark_speech(ari, cute_face);
close_textbox();
wait(0.75);

next_line(); // 13
wait(0.5);
close_textbox();

sim {
    {
        face(juniper, south);
        animate(juniper, laugh);
        play_sound("SoundEffects/NPCs/Vocal/JuniperLaugh");
        wait(1);
        free bark_speech(valen, sweat_drop);
        wait(1.25);
        animate(juniper, idle);
        face(juniper, west);
    }
}

next_line(); // 14
wait(0.5);
close_textbox();
walk(juniper, vjp2h_juniper_hold_hand);
wait(0.25);

sim {
    {
        free bark_speech(ari, exclamation_mark);
    }
    {
        walk(ari, vjp2h_ari_exit);
    }
    {
        wait(0.5);
        face(valen, north);
        wait(0.5);
        face(valen, east);
        wait(0.5);
        free bark_speech(valen, annoyed);
        wait(1);
        walk(valen, vjp2h_valen_exit);
    }
    {
        walk(juniper, vjp2h_juniper_exit);
    }
    {
        wait(7);
        fade_out(2);
    }
    }

camera_position(vjp2h_camera2);
setup_prop(foraging_basket2);
place_actor(ari, north, vjp2h_ari_foraging1);
animate(ari, action);
place_actor(juniper, north, vjp2h_juniper_watching1);
animate(juniper, sit_ground);
place_actor(valen, north, vjp2h_valen_foraging1);
animate(valen, action);
wait(1);
fade_in(2);


sim {
    {
        wait(1);
        free bark_speech(ari, farming);
    }
    {
        wait(2.5);
        free bark_speech(valen, question_mark);
        face(valen, east);
        wait(1);
        walk(valen, vjp2h_valen_foraging2);
        face(valen, west);
    }
    {
        wait(6);
        fade_out(2);
    }
    }

place_actor(ari, east, vjp2h_ari_foraging2);
animate(ari, idle);
place_actor(valen, south, vjp2h_valen_foraging3);
animate(valen, write);
animate(juniper, lounge);
wait(1);
fade_in(2);

sim {
    {
        wait(1);
        free bark_speech(ari, plant_tonic);
    }
    {
        wait(2.5);
        free bark_speech(valen, cute_face);
    }
    {
        wait(4);
        free bark_speech(ari, hungry);
        wait(1);
        free bark_speech(ari, farming);
        wait(1);
        free bark_speech(ari, yum);
    }
    {
        wait(7);
        free bark_speech(valen, exclamation_mark);
        wait(1);
        free bark_speech(valen, no_hungry);
    }
    {
        wait(9);
        fade_out(2);
    }
    }

camera_position(vjp2h_camera3);
place_actor(ari, south, vjp2h_ari_resting1);
animate(ari, sit);
place_actor(valen, south, vjp2h_valen_resting1);
animate(valen, sit);
place_actor(juniper, west, vjp2h_juniper_foraging1);
animate(juniper, action);
wait(1);
fade_in(2);


sim {
    {
        wait(4.5);
        animate(juniper, idle);
        face(juniper, south);
        wait(1);
        free bark_speech(juniper, ellipses);
        wait(1);
        walk(juniper, vjp2h_juniper_foraging2);
        face(juniper, south);
        wait(1);
        animate(juniper, action);
        wait(2);
        animate(juniper, idle);
        free bark_speech(juniper, annoyed);
        wait(2);
        walk(juniper, vjp2h_juniper_foraging3);
        face(juniper, south);
        wait(1);
        animate(juniper, action);
        wait(1);
        walk(juniper, vjp2h_juniper_foraging4);
        face(juniper, south);
        wait(1);
        animate(juniper, action);
        wait(2);
        animate(juniper, idle);
        free bark_speech(juniper, angry);
    }
    {
        free bark_speech(valen, cute_face);
        wait(1);
        free bark_speech(ari, cute_face);
        wait(12.5);
        free bark_speech(valen, sweat_drop);
    }
    }


sim {
    {
        wait(2);
        next_line(); // 15
    }
    {
        wait(2.5);
        free bark_speech(juniper, exclamation_mark);
        wait(0.5);
        face(juniper, north);
    }
    }

wait(0.5);
next_line(); //16
next_line(); //17
next_line(); //18
next_line(); //19
next_line(); //20
next_line(); //21
next_line(); //22


sim {
    {
        next_line(); //23
        walk(valen, vjp2h_valen_foraging4);
        wait(1.5);
        close_textbox();
    }
    {
        wait(2.5);
        face(juniper, south);
    }
    {
        wait(1);
        free bark_speech(ari, sweat_drop);
        wait(1);
        walk(ari, vjp2h_ari_foraging3);
    }
    }

wait(1.5);

next_line(); //24
next_line(); //25
next_line(); //26
next_line(); //27
next_line(); //28
next_line(); //29
wait(1);   
fade_out(2);

sim {
        animate(juniper, accident);
        place_actor(juniper, south, vjp2h_juniper_water);
    }

fade_in(2.0);
wait(1.5);

wait(5);