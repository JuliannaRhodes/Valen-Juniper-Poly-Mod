scene(eastern_road);
camera_position(vjp2h_camera2);
place_actor(ari, east, vjp2h_ari_entrance);
place_actor(juniper, south, vjp2h_juniper_bridge);
place_actor(valen, north, vjp2h_valen_bridge);
setup_prop(foraging_basket1);
request_music_play(juniper);

sim {
    {
        wait(0.25);
        fade_in(2);
    }
    {
        wait(4);
        free bark_speech(valen, annoyed);
    }
    {
        wait(1.75);
        next_line(); //0
    }

}

next_line(); // 1
next_line(); // 2
next_line(); // 3
next_line(); // 4

sim {
    {
        free bark_speech(valen, ellipses);
        next_line(); // 5
    }
}

next_line(); // 6
        
sim {
    {
        next_line(); // 7
        free bark_speech(juniper, sleepy);
    }
}

next_line(); // 8

sim {
    {
        walk_slow(ari, vjp2h_ari_start);
        face(ari, east);
    }
    {
        next_line(); // 9
        wait(0.75);
    }
}

sim {
    {
        free bark_speech(juniper, exclamation_mark);
        wait(0.5);
        face(juniper, west);
        wait(0.5);
        free bark_speech(valen, question_mark);
    }
    {
        next_line(); // 10
        wait(1);
        free bark_speech(valen, angry);
        close_textbox();
    }
}


walk_slow(ari, vjp2h_ari_bridge);
face(valen, west);

next_line(); // 11
next_line(); // 12
wait(0.75);
free bark_speech(ari, cute_face);
close_textbox();
wait(0.75);

next_line(); // 13
wait(0.75);
close_textbox();

sim {
    {
        face(juniper, south);
        animate(juniper, laugh);
        play_sound("SoundEffects/NPCs/Vocal/JuniperLaugh");
        wait(2.25);
        animate(juniper, idle);
        face(juniper, west);
    }
}

next_line(); // 13